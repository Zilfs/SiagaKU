# URL publik situs (mis. https://siagaku.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia: hanya server, jangan pernah diekspos ke klien
SUPABASE_SERVICE_ROLE_KEY=

# Provider LLM utama: Gemini (isi minimal satu provider: Gemini atau Groq)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Provider LLM cadangan: Groq
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=

# Provider alternatif kompatibel OpenAI (opsional)
ALT_AI_BASE_URL=
ALT_AI_API_KEY=
ALT_AI_MODEL=

# Garam untuk hash IP (wajib, string acak panjang)
IP_SALT=
# Rahasia untuk endpoint cron (wajib)
CRON_SECRET=

# Web Push (opsional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Batas waktu panggilan AI dalam milidetik (default 20000)
AI_TIMEOUT_MS=20000
